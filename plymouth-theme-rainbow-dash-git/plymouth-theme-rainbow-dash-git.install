post_install() {
    cat <<'EOF'
==> To use this theme, select it and rebuild the initramfs:

      sudo plymouth-set-default-theme -R rainbow-dash       # light
      sudo plymouth-set-default-theme -R rainbow-dash-dark  # dark

    Plymouth also requires the 'plymouth' hook in /etc/mkinitcpio.conf
    and the 'splash' kernel parameter.
EOF
}

post_upgrade() {
    post_install
}
