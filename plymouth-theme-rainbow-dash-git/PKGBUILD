# Maintainer: Tanmay Deshpande <work.tanmaydeshpande@gmail.com>

pkgname=plymouth-theme-rainbow-dash-git
pkgver=r1.g653d8ba
pkgrel=1
pkgdesc='Animated Rainbow Dash flying Plymouth boot theme (light and dark variants) (git)'
arch=('any')
url='https://github.com/tanmayd-dev/plymouth-theme-rainbow-dash'
license=('unknown')
depends=('plymouth')
makedepends=('git')
provides=('plymouth-theme-rainbow-dash')
conflicts=('plymouth-theme-rainbow-dash')
install="$pkgname.install"
source=("$pkgname::git+$url.git#branch=arch-support")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$pkgname"

    install -d "$pkgdir/usr/share/plymouth/themes/rainbow-dash" \
               "$pkgdir/usr/share/plymouth/themes/rainbow-dash-dark"

    install -m644 files/*.png \
        "$pkgdir/usr/share/plymouth/themes/rainbow-dash/"
    install -m644 files/rainbow-dash.plymouth files/rainbow-dash.script \
        "$pkgdir/usr/share/plymouth/themes/rainbow-dash/"

    install -m644 files/*.png \
        "$pkgdir/usr/share/plymouth/themes/rainbow-dash-dark/"
    install -m644 files/rainbow-dash-dark.plymouth files/rainbow-dash-dark.script \
        "$pkgdir/usr/share/plymouth/themes/rainbow-dash-dark/"

    # Splash BMP for the systemd-stub UKI (--splash in the mkinitcpio preset);
    # installed to the theme dir because /usr/share/systemd/bootctl/ is owned
    # by systemd and pacman would refuse to overwrite it.
    install -m644 files/splash.bmp \
        "$pkgdir/usr/share/plymouth/themes/rainbow-dash-dark/"
}
