#!/bin/bash

VERSION=1.0.0
PKG="rainbow-dash"
THEMES="rainbow-dash rainbow-dash-dark"

rm -rf "$PKG"
mkdir -p "$PKG/DEBIAN"

for theme in $THEMES
do
    TARGET="$PKG/usr/share/plymouth/themes/$theme"
    mkdir -p "$TARGET"
    for file in files/*.png
    do
        cp -t "$TARGET" "$file"
    done
    cp "files/$theme.plymouth" "$TARGET/$theme.plymouth"
    cp "files/$theme.script" "$TARGET/$theme.script"
done

# Splash BMP for the systemd-stub UKI, shown between firmware and Plymouth.
# Deb systems may not boot UKIs, but the theme dir ships it for parity with
# the Arch packages; /usr/share/systemd/bootctl/ is left to systemd itself.
cp "files/splash.bmp" "$PKG/usr/share/plymouth/themes/rainbow-dash-dark/splash.bmp"

for name in control postinst postrm
do
    cp -t "$PKG/DEBIAN" "files/$name"
done

CONTROL="$PKG/DEBIAN/control"
INSTALL_SIZE=$(du --exclude="$PKG/DEBIAN/*" -bd1 "$PKG" | sed -nEe "s,(^[0-9]+)\s+$PKG$,\1,p")
sed -i -Ee "s,:VERSION:,${VERSION}," "$CONTROL"
sed -i -Ee "s,:INSTALL_SIZE:,${INSTALL_SIZE}," "$CONTROL"
dpkg-deb -b "$PKG" "plymouth-theme-rainbow-dash_${VERSION}_all.deb"
